{
  "name": "gym-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "worker:metrics": "node src/workers/metricsWorker.js",
    "worker:metrics:once": "node src/workers/metricsWorker.js --once",
    "metrics:backfill": "node scripts/backfillAthleteDailyMetrics.js",
    "db:quality:audit": "node scripts/repairDatabaseQuality.js",
    "db:quality:apply": "node scripts/repairDatabaseQuality.js --apply",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:postman": "node scripts/runApiContractTests.js",
    "demo:verify": "node scripts/verifyDemoWorkspace.js",
    "admin:init": "node scripts/createAdminAndAssignData.js",
    "catalog:migrate-system": "node scripts/migrateExercisesToSystemCatalog.js",
    "progress:backfill-scopes": "node scripts/backfillProgressScopes.js",
    "exercises:backfill-localized-names": "node scripts/backfillExerciseLocalizedNames.js --apply",
    "exercises:backfill-weight-config": "node scripts/backfillExerciseWeightConfig.js --apply",
    "exercises:normalize-catalog": "node scripts/normalizeExerciseCatalog.js",
    "plans:backfill": "node scripts/backfillTrainingPlans.js",
    "plans:migrate-structure": "node scripts/migratePlanningStructure.js --apply",
    "plans:migrate-coach-templates": "node scripts/migrateCoachPlansToTemplates.js --apply",
    "plans:remove-default-templates": "node scripts/removeDefaultTrainingTemplates.js --apply",
    "sync:cloudinary-exercises": "node scripts/syncCloudinaryExercises.js",
    "import:exercises-excel": "node scripts/importExercisesFromExcel.js",
    "import:exercises-dataset": "node scripts/importExercisesDataset.js",
    "upload:exercises-dataset-media": "node scripts/uploadDatasetMediaToCloudinary.js",
    "build:cloudinary-map": "node scripts/buildCloudinaryMap.js",
    "clear:exercise-images": "node scripts/clearExerciseImages.js",
    "export:cloudinary-template": "node scripts/exportExerciseIds.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
