MONGO_URI=mongodb://localhost:27017/gym
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_POOL_SIZE=10
SLOW_REQUEST_MS=1500
REDIS_URL=
CACHE_MEMORY_MAX_ENTRIES=256
BACKEND_REGION=
MONGO_REGION=
METRICS_WORKER_POLL_MS=2000
METRICS_WORKER_MAX_ATTEMPTS=3
PORT=4000
JWT_SECRET=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
COOKIE_EXPIRES=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Client ID web de Google Identity Services. No es el Client Secret.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback
FACEBOOK_CLIENT_URL=
DEMO_MODE=false
DEMO_WORKSPACE_HOURS=12
DEMO_HISTORY_TRAININGS=200
DEMO_CLIENT_URL=https://demo.rirfit.com
# Resend recomendado. EMAIL_FROM debe usar un dominio verificado en Resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Remitente transaccional de la marca verificada en Resend.
EMAIL_FROM=RIRFIT <no-reply@mail.rirfit.com>
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_REQUIRED=true

# Alternativa SMTP generica (se usa cuando EMAIL_PROVIDER no es resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEV_ADMIN_LOGIN=false
DEV_ADMIN_EMAIL=

# Solo para ejecuciones administrativas controladas. No conservar la
# contrasena en archivos compartidos ni en variables persistentes de Render.
ADMIN_EMAIL=
ADMIN_NAME=Administrador RIRFIT
ADMIN_PASSWORD=
# Produccion HTTPS cross-domain:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.rirfit.com
# Beta sin dominio propio:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gym/exercises
CLOUDINARY_FOLDER_ALIASES=exercises
CLOUDINARY_EXERCISES_FOLDER=gym/exercises
CLOUDINARY_PHOTOS_FOLDER=gym/photos

# URL local usada para previsualizar propuestas creadas por Codex.
CODEX_IMAGE_BASE_URL=http://localhost:4000
CODEX_IMAGE_AUTO_QUEUE=true
CODEX_IMAGE_AUTO_QUEUE_MAX_OUTSTANDING=25
CODEX_IMAGE_AUTO_QUEUE_INTERVAL_MS=300000
